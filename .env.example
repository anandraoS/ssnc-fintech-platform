# Copy to .env (never commit .env). Every value below is a PLACEHOLDER for local, synthetic use only.
# In shared environments these come from a secrets manager (see docs/operations/secrets-management.md), never from files.

# PostgreSQL used by docker-compose (choose your own value)
POSTGRES_PASSWORD=CHANGE_ME_local_db_password

# Password shared by the synthetic demo users of the LOCAL token issuer (local profile only)
LOCAL_DEMO_PASSWORD=CHANGE_ME_demo_password

# HMAC key for the LOCAL token issuer: at least 32 bytes. Generate one, e.g.:  openssl rand -base64 36
LOCAL_ISSUER_HMAC_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_36

# Grafana admin password for the local observability stack
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# --- optional overrides used outside compose -------------------------------------------------------------------
# SERVER_PORT=18480
# CLEARING_URL=http://localhost:18490      # blank => in-process approve-all substitute
# OIDC_ISSUER_URI=https://idp.example.invalid/realms/demo    # production-style token validation (disable the local issuer)
# DB_URL=jdbc:postgresql://localhost:5432/platform
# DB_USER=platform
# DB_PASSWORD=
