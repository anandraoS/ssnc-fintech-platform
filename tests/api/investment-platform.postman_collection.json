{
  "info": {
    "name": "Investment platform API (synthetic)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18480"
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', Date.now().toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "login as operator",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"opsToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"omar.ops\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "login as customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"aliceToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice.customer\",\n  \"password\": \"{{password}}\"\n}"
        }
      }
    },
    {
      "name": "anonymous request is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401\", () => pm.response.to.have.status(401));",
              "pm.test(\"standard error envelope\", () => pm.expect(pm.response.json().code).to.eql(\"UNAUTHENTICATED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        }
      }
    },
    {
      "name": "own accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"money is a string\", () => pm.expect(pm.response.json().items[0].balance).to.be.a(\"string\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts?size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ],
          "query": [
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "deposit accepted",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"202\", () => pm.response.to.have.status(202));",
              "pm.test(\"Location header\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/transactions/\"));",
              "pm.collectionVariables.set(\"txId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}-deposit"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"DEPOSIT\",\n  \"targetAccountId\": \"10000000-0000-4000-8000-000000000001\",\n  \"amount\": \"5.00\",\n  \"currency\": \"USD\"\n}"
        }
      }
    },
    {
      "name": "same request again is replayed, not duplicated",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"202\", () => pm.response.to.have.status(202));",
              "pm.test(\"replayed\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
              "pm.test(\"same transaction\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"txId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}-deposit"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"DEPOSIT\",\n  \"targetAccountId\": \"10000000-0000-4000-8000-000000000001\",\n  \"amount\": \"5.00\",\n  \"currency\": \"USD\"\n}"
        }
      }
    },
    {
      "name": "same key with different payload is refused",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422\", () => pm.response.to.have.status(422));",
              "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_REUSED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}-deposit"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"DEPOSIT\",\n  \"targetAccountId\": \"10000000-0000-4000-8000-000000000001\",\n  \"amount\": \"6.00\",\n  \"currency\": \"USD\"\n}"
        }
      }
    },
    {
      "name": "missing Idempotency-Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400\", () => pm.response.to.have.status(400));",
              "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_REQUIRED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"DEPOSIT\",\n  \"targetAccountId\": \"10000000-0000-4000-8000-000000000001\",\n  \"amount\": \"5.00\",\n  \"currency\": \"USD\"\n}"
        }
      }
    },
    {
      "name": "insufficient funds is a business rejection",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422\", () => pm.response.to.have.status(422));",
              "pm.test(\"reason\", () => pm.expect(pm.response.json().details.failureCode).to.eql(\"INSUFFICIENT_FUNDS\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}-overdraw"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"WITHDRAWAL\",\n  \"sourceAccountId\": \"10000000-0000-4000-8000-000000000001\",\n  \"amount\": \"99999999.00\",\n  \"currency\": \"USD\"\n}"
        }
      }
    },
    {
      "name": "validation errors are itemised",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400\", () => pm.response.to.have.status(400));",
              "pm.test(\"violations listed\", () => pm.expect(pm.response.json().violations.length).to.be.above(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{runId}}-invalid"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"DEPOSIT\",\n  \"amount\": \"-1\",\n  \"currency\": \"usd\"\n}"
        }
      }
    },
    {
      "name": "another customer's account is invisible (BOLA)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404, not 403 (no existence leak)\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/10000000-0000-4000-8000-000000000004",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "10000000-0000-4000-8000-000000000004"
          ]
        }
      }
    },
    {
      "name": "customers cannot see operations data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{aliceToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ops/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ops",
            "summary"
          ]
        }
      }
    },
    {
      "name": "operations summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has latency block\", () => pm.expect(pm.response.json()).to.have.property(\"processingLatency\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{opsToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ops/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ops",
            "summary"
          ]
        }
      }
    },
    {
      "name": "platform health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"components\", () => pm.expect(pm.response.json().components.length).to.be.at.least(4));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{opsToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ops/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ops",
            "health"
          ]
        }
      }
    },
    {
      "name": "ledger integrity is empty",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"no mismatching accounts\", () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{opsToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ops/ledger-integrity",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ops",
            "ledger-integrity"
          ]
        }
      }
    }
  ]
}