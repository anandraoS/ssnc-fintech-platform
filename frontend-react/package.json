{
  "name": "investment-ops-ui-react",
  "version": "1.0.0",
  "description": "React edition of the operations dashboard and customer portal for the synthetic Investment Account and Transaction Management Platform. Same REST contract as the Angular app (synthetic data only).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
